{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PookieClip",
  "mainBinaryName": "pookieclip",
  "version": "0.1.0",
  "identifier": "io.github.gracepetermutiibwa.pookieclip",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "PookieClip",
        "width": 864,
        "height": 576,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "publisher": "Grace Peter Mutiibwa",
    "copyright": "Copyright (c) 2026 Grace Peter Mutiibwa",
    "license": "MIT",
    "homepage": "https://github.com/GracePeterMutiibwa/pookieclip",
    "category": "Utility",
    "shortDescription": "A private clipboard history for Linux",
    "longDescription": "PookieClip keeps your clipboard history on your own machine: text, links, colors and copied files, with its own saved copies of files so you can paste them again later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/extension.js": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/extension.js",
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/metadata.json": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/metadata.json",
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/icons/pookieclip-symbolic.svg": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/icons/pookieclip-symbolic.svg",
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/schemas/org.gnome.shell.extensions.pookieclip.gschema.xml": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/schemas/org.gnome.shell.extensions.pookieclip.gschema.xml",
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/schemas/gschemas.compiled": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/schemas/gschemas.compiled"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/extension.js": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/extension.js",
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/metadata.json": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/metadata.json",
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/icons/pookieclip-symbolic.svg": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/icons/pookieclip-symbolic.svg",
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/schemas/org.gnome.shell.extensions.pookieclip.gschema.xml": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/schemas/org.gnome.shell.extensions.pookieclip.gschema.xml",
          "/usr/share/gnome-shell/extensions/pookieclip@gracepetermutiibwa.github.io/schemas/gschemas.compiled": "../gnome-extension/pookieclip@gracepetermutiibwa.github.io/schemas/gschemas.compiled"
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
